# App Research Agent Configuration

# LLM Provider: 'openai', 'gemini', 'groq', 'anthropic', 'ollama', or 'heuristic' (auto selects available key)
LLM_PROVIDER=auto

# API Keys (Provide at least one for LLM synthesis; defaults to heuristic engine if none)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Custom / Local endpoint (e.g., Ollama or vLLM)
OPENAI_BASE_URL=
MODEL_NAME=

# Composio Integration (Rule 5: Where possible, wire search/scrape through Composio)
COMPOSIO_API_KEY=

# Alternative External Search Providers (falls back to built-in plain search if empty)
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_API_KEY=

# Pipeline Settings
CONCURRENCY_LIMIT=5
REQUEST_TIMEOUT=20
MAX_RETRIES=3
CACHE_DIR=cache
RESULTS_DIR=results
VERIFY_QUOTES=true
